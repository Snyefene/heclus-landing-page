# Base URL of the Heclus app
NEXT_PUBLIC_APP_URL=https://app.heclus.com

# Supabase project that backs the Heclus app (same one youtube-engine uses).
# The landing page only reads the founder promo state — server-side, in the
# Pricing Server Component — via the get_founder_promo_state RPC.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
